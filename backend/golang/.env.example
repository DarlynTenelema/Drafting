PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/drafting?sslmode=disable
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=drafting
DB_PORT=5432
JWT_SECRET=your_super_secret_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Dominio propio para la API y media (portabilidad total sin depender de URLs de proveedor)
BASE_URL=https://api.tudominio.com
MEDIA_PUBLIC_URL=https://media.tudominio.com
ALLOWED_ORIGINS=*

# Verificación de compras de Google Play Developer API
# Valores: false (desactivado), audit (registra logs sin bloquear), true (rechaza recibos inválidos)
GOOGLE_PLAY_VERIFICATION_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=com.drafting.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Stripe Integration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
FRONTEND_URL=http://localhost:3000

# Object Storage S3-Compatible (Funciona con Cloudflare R2, MinIO en Bare Metal, Hetzner S3, Backblaze B2)
# Opción A (Genérica recomendada para migración):
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=drafting-reels

# Opción B (Retrocompatible con Cloudflare R2):
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=drafting-reels
R2_PUBLIC_URL=https://media.tudominio.com

# Caché futura para escala (opcional en 2,000 usuarios, lista para Bare Metal)
REDIS_URL=

# Protección de producción para Brief / Reels (ajustable sin recompilar)
MODERATION_MAX_CONCURRENCY=2
MAX_REELS_PER_DAY_PER_USER=2
MAX_REELS_PER_WEEK_PER_USER=10
MAX_GLOBAL_REELS_PER_DAY=2000
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=40
