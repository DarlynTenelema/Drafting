# Example environment variables for the backend
# Copy this file to `.env` and fill in the real values on your server or local dev machine.

# Server port
PORT=8080

# PostgreSQL connection string (Supabase example)
# For lib/pq or pgx DSN formats you can use either:
# postgres://USER:PASSWORD@HOST:5432/DBNAME
# or the space-separated DSN used elsewhere in the project:
# host=HOST user=USER password=PASSWORD dbname=DBNAME port=5432 sslmode=disable
DATABASE_URL=postgres://postgres:replace_with_password@db.example.supabase.co:5432/postgres

# Google OAuth client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Gemini / Generative AI API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: global free trial launch event window (ISO 8601). Leave empty if not used.
# Example:
# GLOBAL_FREE_TRIAL_START_DATE=2026-08-05T00:00:00Z
# GLOBAL_FREE_TRIAL_END_DATE=2026-08-08T23:59:59Z
GLOBAL_FREE_TRIAL_START_DATE=
GLOBAL_FREE_TRIAL_END_DATE=

# Google Play purchase verification settings
GOOGLE_PLAY_VERIFICATION_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=com.example.drafting
# Absolute path to the Google Play service account JSON key file on the server
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/path/to/play-service-account.json
# For local testing only, allow unverified purchases if verification is not enabled.
ALLOW_UNVERIFIED_PURCHASES=false

# Environment tag: development | staging | production
ENV=development

# JWT secret used to sign session tokens. MUST be set in production.
# Use a long, random string. Example generation (Linux/macOS):
#   openssl rand -base64 32
JWT_SECRET=replace_with_a_strong_random_secret
