<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">

    <!-- Burbuja Minimizada (Estilo WhatsApp) -->
    <ImageButton
        android:id="@+id/btnCollapsedBubble"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start|top"
        android:background="@drawable/bg_hextech_button"
        android:src="@drawable/ic_general" 
        android:tint="#FFFFFF"
        android:scaleType="centerInside"
        android:elevation="6dp"
        android:alpha="0.75"
        android:contentDescription="Expandir Controles"
        android:visibility="gone" />

    <!-- Contenedor Expandido -->
    <LinearLayout
        android:id="@+id/expandedContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:alpha="0.85">

        <!-- Contenedor del Mensaje de la IA (Izquierda) -->
        <FrameLayout
            android:id="@+id/messageContainer"
            android:layout_width="250dp"
            android:layout_height="120dp"
            android:layout_marginEnd="12dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_hextech_panel"
            android:visibility="gone">

            <!-- Estado de Carga -->
            <LinearLayout
                android:id="@+id/loadingLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">
                
                <ProgressBar
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:indeterminateTint="#3B82F6" />
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Cargando..."
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Estado de Resultado -->
            <ScrollView
                android:id="@+id/resultScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:visibility="gone">
                
                <TextView
                    android:id="@+id/resultTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#00E5FF"
                    android:textStyle="bold"
                    android:textSize="18sp" />
            </ScrollView>
        </FrameLayout>

        <!-- Controles (Derecha) -->
        <LinearLayout
            android:id="@+id/controlsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_gravity="center_vertical">
            
            <ImageView
                android:id="@+id/dragHandle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="8dp"
                android:src="@drawable/ic_drag_handle"
                android:contentDescription="Arrastrar" />
            
            <!-- Botones de Captura (Autofill, OTP, In-Game) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Botón Autofill -->
                <ImageButton
                    android:id="@+id/btnCaptureAutofill"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_hextech_button"
                    android:src="@drawable/ic_general"
                    android:tint="#C89B3C"
                    android:scaleType="centerInside"
                    android:elevation="6dp"
                    android:contentDescription="Autofill" />

                <!-- Botón OTP -->
                <ImageButton
                    android:id="@+id/btnCaptureOTP"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_hextech_button"
                    android:src="@drawable/ic_otp"
                    android:tint="#C89B3C"
                    android:scaleType="centerInside"
                    android:elevation="6dp"
                    android:contentDescription="OTP" />

                <!-- Botón In-Game -->
                <ImageButton
                    android:id="@+id/btnCaptureInGame"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_hextech_button"
                    android:src="@drawable/ic_in_game"
                    android:tint="#C89B3C"
                    android:scaleType="centerInside"
                    android:elevation="6dp"
                    android:contentDescription="En Partida" />
            </LinearLayout>
                
            <!-- Controles Adicionales Inferiores -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center">
                
                <!-- Botón de Ocultar/Minimizar (X) -->
                <ImageButton
                    android:id="@+id/btnMinimize"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_hextech_button"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="#FFFFFF"
                    android:scaleType="centerInside"
                    android:elevation="6dp"
                    android:contentDescription="Ocultar" />

                <!-- Botón de Apagar Servicio por Completo (Power) -->
                <ImageButton
                    android:id="@+id/btnClose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_hextech_close"
                    android:src="@android:drawable/ic_lock_power_off"
                    android:tint="#FFFFFF"
                    android:scaleType="centerInside"
                    android:elevation="6dp"
                    android:contentDescription="Apagar Sistema" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
