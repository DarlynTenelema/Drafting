<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">

    <!-- Burbuja Minimizada (Estilo Messenger / Shazam) -->
    <ImageButton
        android:id="@+id/btnCollapsedBubble"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="start|top"
        android:background="@drawable/bg_hextech_button"
        android:src="@drawable/ic_general"
        android:tint="#C89B3C"
        android:scaleType="fitCenter"
        android:padding="10dp"
        android:cropToPadding="true"
        android:elevation="8dp"
        android:alpha="0.90"
        android:contentDescription="Expandir Asistente"
        android:visibility="gone" />

    <!-- Contenedor Principal Expandido -->
    <LinearLayout
        android:id="@+id/expandedContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:alpha="0.92">

        <!-- Panel de Respuesta de IA + Chatbot en Tiempo Real -->
        <FrameLayout
            android:id="@+id/messageContainer"
            android:layout_width="340dp"
            android:layout_height="260dp"
            android:layout_marginEnd="10dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_hextech_panel"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Barra Superior: Título, Transparencia, Tamaño, Copiar y Convertir en Botón -->
                <LinearLayout
                    android:id="@+id/messageHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="4dp"
                    android:background="#151A23">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_general"
                        android:tint="#00E5FF"
                        android:contentDescription="Drafting" />

                    <TextView
                        android:id="@+id/messageTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="RECOMENDACIÓN AI"
                        android:textColor="#C89B3C"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <ImageButton
                        android:id="@+id/btnToggleOpacity"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="4dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_opacity"
                        android:tint="#CBD5E1"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:contentDescription="Transparencia" />

                    <ImageButton
                        android:id="@+id/btnToggleSize"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="4dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_resize"
                        android:tint="#CBD5E1"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:contentDescription="Cambiar tamaño" />

                    <ImageButton
                        android:id="@+id/btnHeaderTts"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="4dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_tts_play"
                        android:tint="#00E5FF"
                        android:scaleType="fitCenter"
                        android:padding="4dp"
                        android:contentDescription="Narrar recomendación" />

                    <ImageButton
                        android:id="@+id/btnCopyMessage"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="4dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_copy"
                        android:tint="#CBD5E1"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:contentDescription="Copiar recomendación" />

                    <!-- Botón para minimizar el panel/chat a un botón compacto sin estorbar en pantalla -->
                    <ImageButton
                        android:id="@+id/btnCloseMessage"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_revert"
                        android:tint="#00E5FF"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:contentDescription="Convertir en botón compacto" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2D3748" />

                <!-- Contenido Principal: Loading / Scrollable Result -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <!-- Estado de Carga -->
                    <LinearLayout
                        android:id="@+id/loadingLayout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:indeterminateTint="#00E5FF" />

                        <TextView
                            android:id="@+id/loadingTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Analizando partida..."
                            android:textColor="#FFFFFF"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Estado de Resultado -->
                    <ScrollView
                        android:id="@+id/resultScrollView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/resultTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textStyle="normal"
                            android:lineSpacingExtra="3dp"
                            android:textSize="13.5sp" />
                    </ScrollView>
                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2D3748" />

                <!-- Barra de Chatbot en Tiempo Real (Punto 1.8: Runas, Objetos y Dudas, máx 50 palabras) -->
                <LinearLayout
                    android:id="@+id/chatBarLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="6dp"
                    android:background="#0F141D">

                    <!-- Botón para colapsar/expandir la barra de chat en un botón pequeño -->
                    <ImageButton
                        android:id="@+id/btnCollapseChatBar"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_role_btn"
                        android:src="@android:drawable/sym_action_chat"
                        android:tint="#00E5FF"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:contentDescription="Minimizar o abrir chat" />

                    <EditText
                        android:id="@+id/chatInputEditText"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_rounded_dark"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:hint="Pregunta por runas, objetos o dudas..."
                        android:textColor="#FFFFFF"
                        android:textColorHint="#94A3B8"
                        android:textSize="11.5sp"
                        android:singleLine="true"
                        android:maxLength="320"
                        android:imeOptions="actionSend"
                        android:inputType="text" />

                    <ImageButton
                        android:id="@+id/btnSendChat"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_hextech_button"
                        android:src="@android:drawable/ic_menu_send"
                        android:tint="#C89B3C"
                        android:scaleType="fitCenter"
                        android:padding="6dp"
                        android:contentDescription="Enviar consulta al chat" />
                </LinearLayout>
            </LinearLayout>

            <!-- Grip táctil para redimensionar arrastrando desde la esquina -->
            <ImageView
                android:id="@+id/btnResizeCorner"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="2dp"
                android:padding="2dp"
                android:src="@drawable/ic_resize_corner"
                android:tint="#A0C89B3C"
                android:alpha="0.8"
                android:contentDescription="Ajustar tamaño arrastrando" />
        </FrameLayout>

        <!-- Columna de Controles Limpia y Automática (Sin botones de cerrar ni roles) -->
        <LinearLayout
            android:id="@+id/controlsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_gravity="center_vertical">

            <!-- Botón Principal de Captura (Se reemplaza automáticamente por btnRefreshDraft tras tomar la 1ra captura) -->
            <ImageButton
                android:id="@+id/btnCaptureGeneral"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_hextech_button"
                android:src="@drawable/ic_general"
                android:tint="#C89B3C"
                android:scaleType="fitCenter"
                android:padding="11dp"
                android:cropToPadding="true"
                android:elevation="8dp"
                android:contentDescription="Analizar Draft" />

            <!-- Botón de Reconsultar Alternativas (Oculto al inicio; reemplaza al botón de captura tras la 1ra foto) -->
            <ImageButton
                android:id="@+id/btnRefreshDraft"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_hextech_button"
                android:src="@android:drawable/ic_popup_sync"
                android:tint="#00E5FF"
                android:scaleType="fitCenter"
                android:padding="11dp"
                android:cropToPadding="true"
                android:elevation="8dp"
                android:visibility="gone"
                android:contentDescription="Reconsultar Alternativas sin tomar otra foto" />

            <!-- Botón de Voz / Narrador Táctico (Oculto al inicio; aparece automáticamente tras tomar la captura) -->
            <ImageButton
                android:id="@+id/btnTtsPlayPause"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_hextech_tts"
                android:src="@drawable/ic_tts_play"
                android:tint="#00E5FF"
                android:scaleType="fitCenter"
                android:padding="9dp"
                android:cropToPadding="true"
                android:elevation="8dp"
                android:visibility="gone"
                android:contentDescription="Reproducir o pausar voz" />

            <!-- Botón Flotante de Chat Rápido (Permite convertir/abrir el chat desde un botón compacto) -->
            <ImageButton
                android:id="@+id/btnQuickChatBubble"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_hextech_button"
                android:src="@android:drawable/sym_action_chat"
                android:tint="#C89B3C"
                android:scaleType="fitCenter"
                android:padding="9dp"
                android:cropToPadding="true"
                android:elevation="6dp"
                android:visibility="gone"
                android:contentDescription="Abrir o minimizar chat táctico" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
