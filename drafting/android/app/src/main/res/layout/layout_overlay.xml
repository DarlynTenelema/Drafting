<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">

    <!-- Burbuja Minimizada (Estilo WhatsApp) -->
    <ImageButton
        android:id="@+id/btnCollapsedBubble"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start|top"
        android:background="@drawable/bg_hextech_button"
        android:src="@drawable/ic_general" 
        android:tint="#FFFFFF"
        android:scaleType="fitCenter"
        android:padding="10dp"
        android:cropToPadding="true"
        android:elevation="6dp"
        android:alpha="0.75"
        android:contentDescription="Expandir Controles"
        android:visibility="gone" />

    <!-- Contenedor Expandido -->
    <LinearLayout
        android:id="@+id/expandedContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:alpha="0.85">

        <!-- Contenedor del Mensaje de la IA (Izquierda) - Ampliado para cómoda lectura -->
        <FrameLayout
            android:id="@+id/messageContainer"
            android:layout_width="340dp"
            android:layout_height="230dp"
            android:layout_marginEnd="12dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_hextech_panel"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Barra Superior: Título y Botón Cerrar Mensaje -->
                <LinearLayout
                    android:id="@+id/messageHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="4dp"
                    android:background="#151A23">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_general"
                        android:tint="#00E5FF"
                        android:contentDescription="Drafting" />

                    <TextView
                        android:id="@+id/messageTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="RECOMENDACIÓN AI"
                        android:textColor="#C89B3C"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <ImageButton
                        android:id="@+id/btnToggleOpacity"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="4dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_opacity"
                        android:tint="#CBD5E1"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:contentDescription="Transparencia" />

                    <ImageButton
                        android:id="@+id/btnToggleSize"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="4dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_resize"
                        android:tint="#CBD5E1"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:contentDescription="Cambiar tamaño" />

                    <ImageButton
                        android:id="@+id/btnCopyMessage"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="4dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_copy"
                        android:tint="#CBD5E1"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:contentDescription="Copiar recomendación" />

                    <ImageButton
                        android:id="@+id/btnCloseMessage"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:tint="#CBD5E1"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:contentDescription="Cerrar recomendación" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2D3748" />

                <!-- Contenido Principal: Loading / Scrollable Result -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <!-- Estado de Carga -->
                    <LinearLayout
                        android:id="@+id/loadingLayout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">
                        
                        <ProgressBar
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:indeterminateTint="#00E5FF" />
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Analizando partida..."
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Estado de Resultado -->
                    <ScrollView
                        android:id="@+id/resultScrollView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="12dp"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false"
                        android:visibility="gone">
                        
                        <TextView
                            android:id="@+id/resultTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textStyle="normal"
                            android:lineSpacingExtra="4dp"
                            android:textSize="14.5sp" />
                    </ScrollView>
                </FrameLayout>
            </LinearLayout>

            <!-- Grip táctil para redimensionar arrastrando con el dedo libremente -->
            <ImageView
                android:id="@+id/btnResizeCorner"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="3dp"
                android:padding="2dp"
                android:src="@drawable/ic_resize_corner"
                android:tint="#A0C89B3C"
                android:alpha="0.8"
                android:contentDescription="Ajustar tamaño arrastrando" />
        </FrameLayout>

        <!-- Controles (Derecha) -->
        <LinearLayout
            android:id="@+id/controlsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_gravity="center_vertical">
            
            <ImageView
                android:id="@+id/dragHandle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="8dp"
                android:src="@drawable/ic_drag_handle"
                android:contentDescription="Arrastrar" />
            
            <!-- Botón Único de Captura (General Draft) -->
            <ImageButton
                android:id="@+id/btnCaptureGeneral"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_hextech_button"
                android:src="@drawable/ic_general"
                android:tint="#C89B3C"
                android:scaleType="fitCenter"
                android:padding="11dp"
                android:cropToPadding="true"
                android:elevation="8dp"
                android:contentDescription="Analizar Draft" />
                
            <!-- Controles Adicionales Inferiores -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center">
                
                <!-- Botón de Ocultar/Minimizar (X) -->
                <ImageButton
                    android:id="@+id/btnMinimize"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_hextech_button"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="#FFFFFF"
                    android:scaleType="fitCenter"
                    android:padding="8dp"
                    android:cropToPadding="true"
                    android:elevation="6dp"
                    android:contentDescription="Ocultar" />

                <!-- Botón de Apagar Servicio por Completo (Power) -->
                <ImageButton
                    android:id="@+id/btnClose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_hextech_close"
                    android:src="@android:drawable/ic_lock_power_off"
                    android:tint="#FFFFFF"
                    android:scaleType="fitCenter"
                    android:padding="8dp"
                    android:cropToPadding="true"
                    android:elevation="6dp"
                    android:contentDescription="Apagar Sistema" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
