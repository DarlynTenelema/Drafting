# Root .gitignore for the project

# Ignore backend environment file (do not commit secrets)
backend/.env

# Generic env files
*.env

# Markdown files (User requested to ignore)
*.md

# Flutter build outputs and generated files (minimal)
/drafting/build/
/drafting/.dart_tool/
/drafting/.flutter-plugins
/drafting/.flutter-plugins-dependencies

# Go compiled binary (should never be committed)
backend/golang/server
backend/golang/*.exe

# Android build reports and artifacts
drafting/android/build/
