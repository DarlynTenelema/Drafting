# ==============================================================================
# Root .gitignore - Drafting Project Security & Hygiene
# ==============================================================================

# --- 1. Environment & Sensitive Configuration Files ---
*.env
*.env.*
!.env.example
.env
backend/.env
backend/golang/.env

# --- 2. Keys, Certificates & Keystores ---
*.keystore
*.jks
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
key.properties
!key.properties.example
upload-keystore.jks
upload_certificate.pem

# --- 3. Cloud & Service Credentials ---
google-services.json
**/google-services.json
GoogleService-Info.plist
*service-account*.json
*credentials*.json
gcp-credentials*.json
*firebase*.json
*adminsdk*.json
firebase-*.json
serviceAccountKey.json
glassy-*.json

# --- 4. Database Files & Backups ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sql.gz

# --- 5. Compiled Binaries & Executables ---
*.exe
backend/golang/server
backend/golang/*.exe
backend/golang/bin/
backend/golang/out
**/bin/
*.dll
*.so
*.dylib

# --- 6. Flutter & Mobile Build Artifacts ---
/drafting/build/
/drafting/.dart_tool/
/drafting/.flutter-plugins
/drafting/.flutter-plugins-dependencies
/drafting/.pub-cache/
/drafting/.pub/
drafting/android/build/
drafting/android/.gradle/
drafting/android/local.properties
drafting/android/gradle/wrapper/gradle-wrapper.jar
drafting/android/gradlew
drafting/android/gradlew.bat
*.apk
*.aab

# --- 7. Logs & Temporary Files ---
*.log
*.tmp
*.bak
*.swp

# --- 8. IDE & Operating System ---
.DS_Store
Thumbs.db
.idea/
*.iml
*.ipr
*.iws
.vscode/
comentarios/

# --- 9. Documentation (per repository configuration) ---
*.md
!README.md

# --- 10. Reference Screenshots, Media, Python Cache & Local AI Weights ---
Items/
campeones/
runas/
Campeones_masterizados/
Estadísticas_de_partida/
Estadísticas_especiales/
Estadísticas_generales/
Historial_de_objetos/
*.mp4
*.mov
*.avi
*.mkv
*.webm
__pycache__/
*.pyc
*.gguf
*.onnx
*.pt
*.pth
*.safetensors
local_ai/models/
local_ai/data/icons_cache/
local_ai/data/wr_icons_cache/
local_ai/data/*.bin
local_ai/data/*.jsonl
local_ai/data/wr_ban_fingerprints.json
local_ai/coach/data/*.jsonl
local_ai/debug_crops/
local_ai/debug_neural/
local_ai/*.zip
drafting/android/app/src/main/assets/*.onnx
drafting/android/app/src/main/assets/*.bin
